<script>
function filterWorks(category) {
  var links = ['link-selected', 'link-uncertainty', 'link-scene', 'link-lowlevel'];
  for (var i = 0; i < links.length; i++) {
    var el = document.getElementById(links[i]);
    if (el) {
      el.style.textDecoration = 'none';
      el.style.fontWeight = 'normal';
      el.style.color = '#2053AB'; 
    }
  }
  var active = document.getElementById('link-' + category);
  if (active) {
    active.style.textDecoration = 'underline';
    active.style.fontWeight = 'bold';
    active.style.color = '#000000';
  }

  var cats = ['selected', 'uncertainty', 'scene', 'lowlevel'];
  for (var i = 0; i < cats.length; i++) {
    var lst = document.getElementById('list-' + cats[i]);
    if (lst) {
      lst.style.display = 'none';
    }
  }
  var activeLst = document.getElementById('list-' + category);
  if (activeLst) {
    activeLst.style.display = 'block';
  }
}
</script>

